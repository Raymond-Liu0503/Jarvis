{
  "name": "jarvis-research-workspace",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:worker": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs worker/index.ts",
    "dev:all": "node node_modules/concurrently/dist/bin/concurrently.js -k -n next,worker 'npm run dev' 'npm run dev:worker'",
    "supabase:start": "npx supabase start",
    "supabase:reset": "npx supabase db reset --local",
    "checkpointer:setup": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs worker/setup-checkpointer.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^1.0.10",
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph": "^1.0.0",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/openrouter": "^0.4.10",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "ai": "^5.0.50",
    "clsx": "^2.1.1",
    "inngest": "^3.44.1",
    "langchain": "^1.0.0",
    "lucide-react": "^0.544.0",
    "next": "15.5.24",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "yaml": "^2.9.0",
    "zod": "^4.1.5",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/pg": "^8.15.5",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
