# Models (OpenRouter model IDs are operator-selected)
OPENROUTER_API_KEY=
MODEL_FAST=
MODEL_REASONING=
MODEL_SYNTHESIS=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Runtime
RESEARCH_EXECUTION_BACKEND=postgres
ALLOW_SIGN_UP=true
WORKER_ID=jarvis-worker-local
WORKER_POLL_INTERVAL_MS=750
WORKER_LEASE_MS=45000
WORKER_HEARTBEAT_MS=10000
WORKER_CONCURRENCY=1
WORKER_MAX_ATTEMPTS=3

# Durable workflows
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set to 1 only when running the local Inngest dev server.
INNGEST_DEV=

# Hub providers
FINANCIAL_DATASETS_API_KEY=
ALPHA_VANTAGE_API_KEY=
OPENWEATHER_API_KEY=
GOOGLE_PLACES_API_KEY=
TICKETMASTER_API_KEY=
EXA_API_KEY=
DUFFEL_ACCESS_TOKEN=
ENABLE_DUFFEL=false
