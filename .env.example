# Models (OpenRouter model IDs are operator-selected)
OPENROUTER_API_KEY=
MODEL_FAST=
MODEL_REASONING=
MODEL_SYNTHESIS=
# Optional compact source reranker. Disabled unless WEB_RESEARCH_RERANK_ENABLED=true.
MODEL_WEB_RESEARCH=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Runtime
ALLOW_SIGN_UP=true
# Optional override; otherwise a process-unique hostname/PID identity is used.
# WORKER_ID=jarvis-worker-local
DATABASE_POOL_MAX=10
WORKER_POLL_INTERVAL_MS=750
WORKER_LEASE_MS=45000
WORKER_HEARTBEAT_MS=10000
WORKER_CONCURRENCY=1
WORKER_MAX_ATTEMPTS=3
WEB_RESEARCH_CONCURRENCY=2
WEB_RESEARCH_CACHE_TTL_HOURS=6
# Keep disabled unless model-based source reranking is explicitly needed.
WEB_RESEARCH_RERANK_ENABLED=false
# Local development only: off | redacted
RESEARCH_DEBUG_PAYLOADS=off

# Hub providers
FINANCIAL_DATASETS_API_KEY=
# Financial Datasets returns HTTP 402 without funded access. Keep off unless funded.
ENABLE_FINANCIAL_DATASETS=false
# Required for SEC EDGAR requests. Format: Jarvis Research your-email@example.com
SEC_USER_AGENT=
ALPHA_VANTAGE_API_KEY=
OPENWEATHER_API_KEY=
GOOGLE_PLACES_API_KEY=
# Optional Routes-specific key; Routes falls back to GOOGLE_PLACES_API_KEY.
GOOGLE_MAPS_API_KEY=
TICKETMASTER_API_KEY=
EXA_API_KEY=
SHERPA_API_KEY=
ENABLE_SHERPA=false
# SHERPA_API_BASE_URL=https://requirements-api.joinsherpa.com
DUFFEL_ACCESS_TOKEN=
ENABLE_DUFFEL=false
